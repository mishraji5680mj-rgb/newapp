# Vercel -> Project -> Settings -> Environment Variables me ye daalein (is file ko commit/upload ZAROORI nahi)

# ---- AI Chatbot (zaroori) ----
GEMINI_API_KEY=your_key_from_https://aistudio.google.com/apikey
# optional: model badalna ho to (default: gemini-3.5-flash-lite, then 3.8-flash, 3.6-flash ...)
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Notifications (sirf agar push notifications chahiye) ----
ADMIN_KEY=koi_lamba_secret_password
CRON_SECRET=koi_lamba_random_string
VAPID_PUBLIC=<push-config.js wali PUBLIC key>
VAPID_PRIVATE=<aapki VAPID private key>
VAPID_SUBJECT=mailto:aapka@email.com
# Upstash Redis (Vercel -> Storage -> Create -> Upstash Redis) connect karne par ye khud ban jate hain:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
